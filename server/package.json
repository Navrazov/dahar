{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "NODE_ENV=production node src/index.ts",
    "user": "node src/cli/users.ts",
    "admin": "node src/cli/admin.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://localhost:5432/dahar_test} node --test --test-concurrency=1 'test/*.test.ts'",
    "worker": "ROLE=worker NODE_ENV=production node src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@dahar/shared": "*",
    "@sentry/node": "^11.4.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
